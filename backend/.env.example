# FastAPI & Project Config
PROJECT_NAME="Betah - Employee Attrition Advisor"
API_V1_STR="/api"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Flexible AI / LLM Configuration (Supports OpenAI, OpenRouter, Groq, Local LLMs, Gemini)
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_BASE_URL="https://api.openai.com/v1"  # Or https://openrouter.ai/api/v1, https://api.groq.com/openai/v1, http://localhost:11434/v1
OPENAI_MODEL_NAME="gpt-4o-mini"              # Or google/gemini-2.0-flash-exp:free, llama-3.3-70b-versatile, etc.

# Google Gemini Alternative
GOOGLE_API_KEY=""

# Custom System Prompt / Context (Optional)
CUSTOM_SYSTEM_PROMPT=""

# Vectorstore & Database Config
CHROMADB_PATH="./chroma_db"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/betah_db"

# MLflow Tracking Configuration
MLFLOW_TRACKING_URI="sqlite:///mlflow.db"
MLFLOW_EXPERIMENT_NAME="attrition_advisor_experiments"
